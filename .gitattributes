# Preserve archived data bytes (including standard CSV CRLF and empty TSV fields).
paper/evidence/**/*.tsv -text whitespace=-blank-at-eol
# Matplotlib SVG path separators legitimately include trailing whitespace.
paper/evidence/**/*.svg -text -whitespace
# Compiler excerpts and unified patch context are immutable provenance bytes.
paper/evidence/comparator_builds/*.log -text whitespace=-blank-at-eol
paper/evidence/comparator_builds/*.patch -text -whitespace
# NCBI report bytes include source CRLF; retain them for MD5/SHA verification.
paper/evidence/Mo17_input_qc/reference/*.txt -text whitespace=cr-at-eol
# Preserve original comparator logs/session reports and native CSV bytes.
paper/evidence/TRASH_installation_controls/** -text -whitespace
paper/evidence/Nipponbare_input_qc/reference/** -text -whitespace
